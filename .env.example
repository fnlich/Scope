# Production problem-service client (Finney NETUID 5)
PROBLEM_SERVER_URL=https://dwvoiuahpq8jj.cloudfront.net
PROBLEM_SERVER_ALLOW_INSECURE_HTTP=false
PROBLEM_SERVER_REQUEST_TIMEOUT_S=60

# Local evaluation
EXECUTOR=docker
# Immutable multi-architecture Python 3.12 slim image. setup_validator.sh pulls
# it and runs Python + GNU timeout before the validator may lease a problem.
DOCKER_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
DOCKER_MEMORY=256m
DOCKER_CPUS=1.0
DOCKER_PIDS_LIMIT=128
PER_TEST_TIMEOUT_S=5
DETERMINISM_RUNS=2
# HTTP fan-out to miners (I/O-bound) and sandbox verification slots (CPU/Docker
# bound) are throttled separately.
VALIDATOR_DISPATCH_CONCURRENCY=256
VALIDATOR_VERIFY_CONCURRENCY=16
VALIDATOR_CHALLENGES_PER_ROUND=1
VALIDATOR_SCORE_STATE_FILE=data/validator_scores.json
# Wait for four completed full-pool challenges before the first weight extrinsic.
# Set to 6 for the five-problem launch rehearsal so submission is impossible.
VALIDATOR_MIN_WEIGHT_OBSERVATIONS=4
# Per-miner signed response cap. All serving miners receive every problem; this
# bound keeps the combined commit and durable archive within server capacity.
MINER_MAX_RESPONSE_BYTES=128000

# Dispatch and rewards. Subset 0 = dispatch every challenge to the FULL pool:
# problems are burned on lease and cost tokens to mint, so measure every miner
# on each one. The problem server, not this client, caps the shared burn rate.
DISPATCH_SUBSET_K=0
PAYMENT_DIFFICULTY_FLOOR=0.25
# Speed is a slight, continuous tiebreaker among correct answers: relative
# penalties are about 0.55% at 30s, 1.03% at 60s, and 3.43% at five minutes.
# The multiplier never falls below 95%; wrong answers earn 0 regardless.
PAYMENT_SPEED_HALF_LIFE_MS=180000
PAYMENT_SPEED_FLOOR=0.95

# Chain identity. setup_validator.sh can populate the two wallet fields.
NETUID=5
SUBTENSOR_NETWORK=finney
WALLET_NAME=YOUR_WALLET_NAME
WALLET_HOTKEY=YOUR_WALLET_HOTKEY

# Lease-attempt cadence. The problem server controls the actual shared burn rate;
# a paced attempt returns no challenge and consumes nothing.
ROUND_INTERVAL_BLOCKS=88
WEIGHTS_INTERVAL_BLOCKS=100

# Demo GLM-5.2 miner (only needed when running start_demo_miner.sh)
# Create a key in the Z.ai console. Never commit the populated .env file.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2
GLM_MAX_TOKENS=16384
GLM_TEMPERATURE=1.0
GLM_THINKING=true
GLM_REASONING_EFFORT=high
GLM_REQUEST_TIMEOUT_S=280
GLM_MAX_RETRIES=2

# The miner binds on all interfaces and advertises its externally reachable
# address through Bittensor. Leave AXON_EXTERNAL_IP empty for auto-detection.
AXON_HOST=0.0.0.0
AXON_PORT=8091
AXON_EXTERNAL_IP=
MINER_MAX_CONCURRENT_REQUESTS=4
MINER_MAX_REQUEST_BYTES=1000000
MINER_METAGRAPH_SYNC_S=300
MINER_MIN_STAKE=0
MINER_REQUIRE_VALIDATOR_PERMIT=true
