# Production problem-service client (Finney NETUID 5)
PROBLEM_SERVER_URL=https://dwvoiuahpq8jj.cloudfront.net
PROBLEM_SERVER_ALLOW_INSECURE_HTTP=false
PROBLEM_SERVER_REQUEST_TIMEOUT_S=60

# Local evaluation
# EXECUTOR=docker
# Immutable multi-architecture Python 3.12 slim image. setup_validator.sh pulls
# it and runs Python + GNU timeout before the validator may lease a problem.
DOCKER_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
# DOCKER_MEMORY=256m
# DOCKER_CPUS=1.0
# DOCKER_PIDS_LIMIT=128
# PER_TEST_TIMEOUT_S=5
# HTTP fan-out to miners (I/O-bound) and sandbox verification slots (CPU/Docker
# bound) are throttled separately.
# VALIDATOR_DISPATCH_CONCURRENCY=256
# Short-lived slots for connection establishment and request upload. Requests
# waiting here are not signed yet; miner solve time does not hold a slot. Keep
# this near 32: very small values can spend too much of the response deadline.
# VALIDATOR_SEND_CONCURRENCY=32
# VALIDATOR_VERIFY_CONCURRENCY=16
# VALIDATOR_SCORE_STATE_FILE=data/validator_scores.json
# Per-miner signed response cap. This keeps the combined commit and durable
# archive within server capacity.
# MINER_MAX_RESPONSE_BYTES=128000

# Dispatch, scoring, cadence, and payment policy are fixed by the release.
# Pulling and restarting adopts the current policy; .env cannot override it.

# Chain identity. setup_validator.sh can populate the two wallet fields.
NETUID=5
SUBTENSOR_NETWORK=finney
WALLET_NAME=YOUR_WALLET_NAME
WALLET_HOTKEY=YOUR_WALLET_HOTKEY

# Demo GLM-5.2 miner (only needed when running start_demo_miner.sh)
# Create a key in the Z.ai console. Never commit the populated .env file.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2
GLM_MAX_TOKENS=16384
GLM_TEMPERATURE=1.0
GLM_THINKING=true
GLM_REASONING_EFFORT=high
# The deadline the miner answers 504 at, as min(request.deadline_s, this). The
# request's deadline is the only deadline worth having: anything smaller is a
# second, private one that silently costs the difference the moment a validator
# advertises more. `TaskRequest.deadline_s` is `le=3600`, so 3600 is
# structurally incapable of binding -- min(deadline_s, 3600) is deadline_s,
# always. 280 was the reference miner's value and sat BELOW the 300s this subnet
# advertises, costing 20 seconds of every solve.
GLM_REQUEST_TIMEOUT_S=3600
GLM_MAX_RETRIES=2

# --------------------------------------------------------------------------
# Browser-driven solver (examples/custom_miner/run_miner.py)
#
# You start the browsers yourself and sign in by hand; the miner attaches over
# CDP. Each browser is one account on its own debugging port:
#
#   ./examples/custom_miner/scripts/start_debug_browser.sh --port 9222
#
# Unset means ONE Claude browser on 9222, which is what that script starts by
# default -- so a single-account setup needs nothing here at all.
# --------------------------------------------------------------------------
# CLAUDE_CDP=9222,9223,9224      # browsers signed in to claude.ai
# CHATGPT_CDP=9225,9226          # browsers signed in to chatgpt.com

# --------------------------------------------------------------------------
# ...or skip the browsers entirely and answer through the Claude Code CLI.
#
# Same subscription, no browser: no DOM to scrape, no copy control to click, no
# network stream to reconstruct, and no page that renders nothing for forty
# seconds while the answer sits on the wire. Measured on the sample challenges,
# both scored, at 91s and 98s of a 290s budget -- against 145-290s through a
# browser.
#
# It needs Claude Code installed and signed in AS THE USER THE MINER RUNS AS:
#
#   npm install -g @anthropic-ai/claude-code
#   claude auth login            # `claude auth status` must say oauth_token
#
# The miner never passes ANTHROPIC_API_KEY to it. A key would outrank the
# subscription and quietly move every solve onto metered billing, which is the
# one thing this miner exists to avoid; SOLVER_CLI_ALLOW_API_KEY=1 if you
# genuinely want that.
# --------------------------------------------------------------------------
# SOLVER_BACKEND=cli             # `browser` (default) or `cli`
# SOLVER_CLI_MODELS=opus         # the default model; any after it are extra
#                                # second-opinion models at the default effort
# SOLVER_CLI_EFFORT=low          # low|medium|high|xhigh|max -- see the note below
#
# WHEN IT FAILS. A seat has three ways of not answering, and each has a rung:
#
#   usage limit  -> the next ACCOUNT. Sign a second subscription in to its own
#                   directory, then name it here. The primary is whatever
#                   `claude` is signed in as with no override.
#                     python -m solvers.claude_cli login ~/.hone-miner/claude-2
#                     python -m solvers.claude_cli status
#   refused model -> the next PROFILE (model:effort), on every account, for
#                   SOLVER_CLI_RECOVERY_S; then the default is tried again by
#                   the next real solve, and re-parked if it fails again.
#   anything else -> the next rung of both.
#
# The log says which rung is answering ("EMERGENCY MODE: ...") and when the
# default is back ("back to normal").
# SOLVER_CLI_BACKUP_ACCOUNTS=~/.hone-miner/claude-2   # comma-separated dirs
# SOLVER_CLI_EMERGENCY_PROFILES=fable:low,sonnet:low  # in order; effort optional.
#                                # Measured on a real problem: fable 38s, opus 86s,
#                                # sonnet 161s per program turn at low; high effort
#                                # did not finish inside the deadline on either.
# SOLVER_CLI_RECOVERY_S=600      # how long a refused model is left alone
#
# THE SECOND READING. Beside every solve, a fresh conversation on another model
# writes its own program and a random-input generator from the statement alone.
# Once the primary passes its own cases, both programs run on generated inputs;
# each disagreement goes to a third reader, and two readings against one puts
# the input on the primary's bar as a confirmed case. The largest generated
# input is also timed. Measured on this miner's archived answers: 2 of 15 that
# had passed their own cases were confirmed wrong this way. The same third
# reader judges every CASE the primary corrects before the correction lands,
# and the second program is the answer of last resort when the primary ends
# with nothing, a fragment, or a program failing its own cases. Costs about
# 1.9x the output tokens of a solve, in parallel, so little wall-clock.
# SOLVER_CROSSCHECK=1            # 0 turns it off
# SOLVER_CROSSCHECK_PROFILE=fable:low   # who writes the second reading
# SOLVER_JUDGE_PROFILE=opus:low         # who adjudicates a disagreement
# SOLVER_CROSSCHECK_INPUTS=60    # generated inputs per solve
# SOLVER_CLI_DRILL=limit:primary # pretend an outage at launch to watch the ladder
#                                # move: limit:<account> or refuse:<model>, comma-
#                                # separated. Expires on its own; remove after.
# SOLVER_CLI_FIRST_TEXT_S=120    # a turn that has streamed this long, and 60+
#                                # events, without ONE character of the answer is
#                                # cut and the next rung is asked. Measured: six
#                                # turns a day emit a 750ms keepalive and no text,
#                                # and two of those solves submitted nothing.
# SOLVER_CLI_CONCURRENCY=8       # `claude` processes at once
# SOLVER_CLI_SWITCH_AT=0.95      # past this share of a seat's window, fresh solves go
#                                # to another seat; the second reading and the judge
#                                # always go to the lightest seat
# SOLVER_CLI_BIN=claude          # if it is not on PATH
# SOLVER_CLI_WORKDIR=~/.hone-miner/cli  # the (empty) directory every `claude` runs in
# SOLVER_CLI_ALLOW_OVERAGE=0     # 1 lets turns run on the plan's PAID extra usage
#                                # once the subscription window is spent. Off,
#                                # that is treated as the limit and the miner
#                                # waits for the reset rather than spending money.
#
# `low` is the default effort on purpose rather than out of thrift: these are
# single-function problems with a hard correctness gate, and the repair loop is
# the better place to spend time because it spends it on evidence. Raise it if
# your problems justify it.

# Conversations per browser. Tabs are cheap; ACCOUNTS are the rate limit that
# actually binds, so add browsers before raising this.
# MINER_TABS_PER_BROWSER=2

# Every answer the miner sends is written here, named for the problem, with the
# request and reply beside it as .json. Empty disables archiving.
# SOLVER_SOLUTION_DIR=solutions

# The self-verify-and-repair loop. Defaults are the ones to run:
#   SOLVER_MAX_ATTEMPTS=0     0 = correct until the deadline stops it
#   SOLVER_SELF_TESTS=true    the model's own cases; live traffic ships no
#                             public examples, so without these nothing can be
#                             graded locally and the repair loop never fires
#   SOLVER_SECOND_OPINION=true    ask the OTHER provider once, when empty-handed
#   SOLVER_VERIFY_EXECUTOR=subprocess    `docker` to grade in a container
# SOLVER_MAX_ATTEMPTS=0
# SOLVER_SELF_TESTS=true
# SOLVER_SECOND_OPINION=true
# SOLVER_VERIFY_EXECUTOR=subprocess

# Selector overrides, for the day a chat UI renames something. Run
# `python -m solvers.doctor claude --probe` first; it prints what to set.
# CLAUDE_COPY_NAME=copy
# CLAUDE_URL=https://claude.ai/new

# The miner binds on all interfaces and advertises its externally reachable
# address through Bittensor. Leave AXON_EXTERNAL_IP empty for auto-detection.
AXON_HOST=0.0.0.0
AXON_PORT=8091
AXON_EXTERNAL_IP=
# How far past the advertised deadline the solve may run. The validator does
# NOT stop at deadline_s: rlvr/neurons/decentralized.py bounds the whole
# exchange at deadline_s + 10 (_MINER_RESPONSE_GRACE_S), and the reference
# handler cancelled the solve at deadline_s flat, giving back seconds nobody
# was asking for. Not all ten -- that grace is also the response's window to
# cross the wire, and the validator's clock starts before the request arrives.
# 0 restores the reference behaviour exactly.
MINER_RESPONSE_GRACE_S=5
MINER_MAX_CONCURRENT_REQUESTS=4
MINER_MAX_REQUEST_BYTES=1000000
MINER_METAGRAPH_SYNC_S=300
MINER_MIN_STAKE=0
MINER_REQUIRE_VALIDATOR_PERMIT=true
