# Production problem-service client (Finney NETUID 5)
PROBLEM_SERVER_URL=https://dwvoiuahpq8jj.cloudfront.net
PROBLEM_SERVER_ALLOW_INSECURE_HTTP=false
PROBLEM_SERVER_REQUEST_TIMEOUT_S=60

# Local evaluation
# EXECUTOR=docker
# Immutable multi-architecture Python 3.12 slim image. setup_validator.sh pulls
# it and runs Python + GNU timeout before the validator may lease a problem.
DOCKER_IMAGE=python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de
# DOCKER_MEMORY=256m
# DOCKER_CPUS=1.0
# DOCKER_PIDS_LIMIT=128
# PER_TEST_TIMEOUT_S=5
# HTTP fan-out to miners (I/O-bound) and sandbox verification slots (CPU/Docker
# bound) are throttled separately.
# VALIDATOR_DISPATCH_CONCURRENCY=256
# Short-lived slots for connection establishment and request upload. Requests
# waiting here are not signed yet; miner solve time does not hold a slot. Keep
# this near 32: very small values can spend too much of the response deadline.
# VALIDATOR_SEND_CONCURRENCY=32
# VALIDATOR_VERIFY_CONCURRENCY=16
# VALIDATOR_SCORE_STATE_FILE=data/validator_scores.json
# Per-miner signed response cap. This keeps the combined commit and durable
# archive within server capacity.
# MINER_MAX_RESPONSE_BYTES=128000

# Dispatch, scoring, cadence, and payment policy are fixed by the release.
# Pulling and restarting adopts the current policy; .env cannot override it.

# Chain identity. setup_validator.sh can populate the two wallet fields.
NETUID=5
SUBTENSOR_NETWORK=finney
WALLET_NAME=YOUR_WALLET_NAME
WALLET_HOTKEY=YOUR_WALLET_HOTKEY

# Demo GLM-5.2 miner (only needed when running start_demo_miner.sh)
# Create a key in the Z.ai console. Never commit the populated .env file.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2
GLM_MAX_TOKENS=16384
GLM_TEMPERATURE=1.0
GLM_THINKING=true
GLM_REASONING_EFFORT=high
# The deadline the miner answers 504 at, as min(request.deadline_s, this). The
# request's deadline is the only deadline worth having: anything smaller is a
# second, private one that silently costs the difference the moment a validator
# advertises more. `TaskRequest.deadline_s` is `le=3600`, so 3600 is
# structurally incapable of binding -- min(deadline_s, 3600) is deadline_s,
# always. 280 was the reference miner's value and sat BELOW the 300s this subnet
# advertises, costing 20 seconds of every solve.
GLM_REQUEST_TIMEOUT_S=3600
GLM_MAX_RETRIES=2

# --------------------------------------------------------------------------
# Browser-driven solver (examples/custom_miner/run_miner.py)
#
# You start the browsers yourself and sign in by hand; the miner attaches over
# CDP. Each browser is one account on its own debugging port:
#
#   ./examples/custom_miner/scripts/start_debug_browser.sh --port 9222
#
# Unset means ONE Claude browser on 9222, which is what that script starts by
# default -- so a single-account setup needs nothing here at all.
# --------------------------------------------------------------------------
# CLAUDE_CDP=9222,9223,9224      # browsers signed in to claude.ai
# CHATGPT_CDP=9225,9226          # browsers signed in to chatgpt.com

# --------------------------------------------------------------------------
# ...or skip the browsers entirely and answer through the Claude Code CLI.
#
# Same subscription, no browser: no DOM to scrape, no copy control to click, no
# network stream to reconstruct, and no page that renders nothing for forty
# seconds while the answer sits on the wire. Measured on the sample challenges,
# both scored, at 91s and 98s of a 290s budget -- against 145-290s through a
# browser.
#
# It needs Claude Code installed and signed in AS THE USER THE MINER RUNS AS:
#
#   npm install -g @anthropic-ai/claude-code
#   claude auth login            # `claude auth status` must say oauth_token
#
# The miner never passes ANTHROPIC_API_KEY to it. A key would outrank the
# subscription and quietly move every solve onto metered billing, which is the
# one thing this miner exists to avoid; SOLVER_CLI_ALLOW_API_KEY=1 if you
# genuinely want that.
# --------------------------------------------------------------------------
# SOLVER_BACKEND=cli             # `browser` (default) or `cli`
# SOLVER_CLI_MODELS=opus         # the default model; any after it are extra
#                                # second-opinion models at the default effort
# SOLVER_CLI_EFFORT=low          # low|medium|high|xhigh|max -- see the note below
#
# WHEN IT FAILS. A seat has three ways of not answering, and each has a rung:
#
#   usage limit  -> the next ACCOUNT. Sign a second subscription in to its own
#                   directory, then name it here. The primary is whatever
#                   `claude` is signed in as with no override.
#                     python -m solvers.claude_cli login ~/.hone-miner/claude-2
#                     python -m solvers.claude_cli status
#   refused model -> the next PROFILE (model:effort), on every account, for
#                   SOLVER_CLI_RECOVERY_S; then the default is tried again by
#                   the next real solve, and re-parked if it fails again.
#   anything else -> the next rung of both.
#
# The log says which rung is answering ("EMERGENCY MODE: ...") and when the
# default is back ("back to normal").
# SOLVER_CLI_BACKUP_ACCOUNTS=~/.hone-miner/claude-2   # comma-separated dirs
# SOLVER_CLI_EMERGENCY_PROFILES=fable:low   # in order; effort optional.
#                                # Two models on the roster, opus and fable,
#                                # so the emergency ladder is one rung. Every
#                                # effort is `low` and that is measured: on a
#                                # real problem one program turn took fable
#                                # 38s and opus 86s, and either model at high
#                                # did not finish inside the deadline. An
#                                # emergency rung answers a WHOLE solve inside
#                                # 290s, which is what that band is for.
#                                # The ORDER goes the other way from the latency,
#                                # and on purpose: an emergency rung answers a whole
#                                # solve, the subnet pays only for a complete pass
#                                # of the hidden suite, and 161s inside a 290s
#                                # deadline is affordable where a wrong answer at
#                                # 38s earns what no answer earns. Sonnet is also
#                                # the only rung measured against the default model
#                                # on this corpus -- 91 of 97 expected values agreed
#                                # in calibration/fixed_inputs.py.
# SOLVER_CLI_RECOVERY_S=600      # how long a refused model is left alone
#
# Which model answers which phase, when you have measured one:
#   SOLVER_CLI_PHASE_PROFILES=cases=fable:low,program=opus:low
# Phases are `cases`, `program`, `repair`, `judge` and `cases2`; the effort
# after the colon is optional and defaults to SOLVER_CLI_EFFORT.
#
# `cases` and `program` are UNSET by default, and that is deliberate -- every
# one of the 102 solves in calibration/logs-*.log opened on the same model, so
# nothing has been measured about how another model answers a cases turn or a
# program turn. Measure it before you set it.
#
# `judge` and `cases2` ARE set, and BOTH TO `fable:low` -- necessarily, since
# with opus and fable on the roster the only seat that is not the program's
# author is fable. They remain two separate settings because what each wants
# from a model is different, and because naming one must not move the other.
# Both exist to be a reader that is not the one writing the program, and
# `avoid` cannot say that: it resolves against the ladder, and `cases2` starts
# before the program's own provider is known.
#
# What that costs, said rather than glossed. The judge settles one expected
# value and the loop treats its answer as the verdict, so it is asked to be
# RIGHT -- and the measurement that applied to it was about SONNET: 91 of 97
# expected values agreed with opus in calibration/fixed_inputs.py, inputs held
# fixed. Nothing under calibration/ measures fable's reading against anyone's,
# so the judge no longer has a number behind it.
#
# What it does not cost: the second bar is asked to be DIFFERENT, not right.
# Its product is the union of two readers' calls, and two models choosing their
# own inputs share about 2% of them (calibration/two_bar_overlap.py) -- a
# property of any two distinct models. Fable was already this seat.
#
# The consequence to know about: the judge and the second bar are now the same
# model, so a call the two BARS split on is kept away from the judge on the
# grounds that it would not be a third reading. That is true again.
#
# A phase names a PREFERENCE, never a pin. A phase whose model is refused on
# every account falls through to the ordinary ladder, and a retry that must
# avoid a provider ("not the one that just got this wrong") beats the
# preference -- so a phase model going down costs that phase its first choice
# and nothing else.
# SOLVER_CLI_PHASE_PROFILES=
#
# SOLVER_CLI_DRILL=limit:primary # pretend an outage at launch to watch the ladder
#                                # move: limit:<account> or refuse:<model>, comma-
#                                # separated. Expires on its own; remove after.
# SOLVER_CLI_FIRST_TEXT_S=120    # a turn that has streamed this long, and 60+
#                                # events, without ONE character of the answer is
#                                # cut and the next rung is asked. Measured: six
#                                # turns a day emit a 750ms keepalive and no text,
#                                # and two of those solves submitted nothing.
# SOLVER_CLI_CONCURRENCY=12      # `claude` processes at once PER ACCOUNT. A solve
#                                # holds three conversations open together (program,
#                                # bar, second bar) and a miner serves four solves at
#                                # once, so twelve; at eight a program turn queued
#                                # behind other solves' second bars.
# SOLVER_CLI_SWITCH_AT=0.95      # past this share of a seat's window, fresh
#                                # conversations -- solves and the named-model turns
#                                # of the second reading and the judge alike -- go to
#                                # another seat while one is free. Below it the first
#                                # seat is drained first. A seat that cannot serve at
#                                # all (full, limited) is left for one past this
#                                # rather than waited on.
# SOLVER_CLI_BIN=claude          # if it is not on PATH
# SOLVER_CLI_WORKDIR=~/.hone-miner/cli  # the (empty) directory every `claude` runs in
# SOLVER_CLI_ALLOW_OVERAGE=0     # 1 lets turns run on the plan's PAID extra usage
#                                # once the subscription window is spent. Off,
#                                # that is treated as the limit and the miner
#                                # waits for the reset rather than spending money.
#
# `low` is the default effort on purpose rather than out of thrift: these are
# single-function problems with a hard correctness gate, and the repair loop is
# the better place to spend time because it spends it on evidence. Raise it if
# your problems justify it.

# Conversations per browser. Tabs are cheap; ACCOUNTS are the rate limit that
# actually binds, so add browsers before raising this.
# MINER_TABS_PER_BROWSER=2

# Every answer the miner sends is written here, named for the problem, with the
# request and reply beside it as .json. Empty disables archiving.
# SOLVER_SOLUTION_DIR=solutions

# The self-verify-and-repair loop. Defaults are the ones to run:
# Every boolean below reads one grammar: 0 / false / no / off are off, anything
# else set is on, unset is the default. (The CLI's SOLVER_CLI_* switches, the
# browser sites' *_STREAM flags and SOLVER_RUST_COMPILE read the same way.)
#   SOLVER_MAX_ATTEMPTS=0     0 = correct until the deadline stops it
#   SOLVER_SELF_TESTS=true    the model's own cases; live traffic ships no
#                             public examples, so without these nothing can be
#                             graded locally and the repair loop never fires
#   SOLVER_SECOND_OPINION=true    ask the OTHER provider once, when empty-handed
#   SOLVER_INDEPENDENT_BAR=true   write the cases in their OWN conversation,
#                             beside the program instead of one turn ahead of
#                             it. Sequentially the program turn reads the cases
#                             turn's output before writing a line, so one model
#                             and one reading of the statement produce both the
#                             answer and the bar it is graded against. Measured
#                             over the 97 solves in calibration/logs-*.log: 96
#                             shipped a program that passed EVERY one of its own
#                             ~18 cases and 71 produced no disagreement at all,
#                             against a hidden-suite pass rate of 78-83%. About
#                             one answer in five clears a bar it wrote for
#                             itself and still fails. Side by side the two turns
#                             also cost max() rather than sum: p50 63.5s instead
#                             of 120.4s, p90 ~171s instead of ~266s, against
#                             shipped solves that ran p90 274s of a 280s stop.
#                             Set 0 for the sequential shape.
#   SOLVER_SECOND_BAR=true    a SECOND bar, beside the first, on another
#                             model, and the program graded against the union.
#                             This is the only thing here that reaches a solve
#                             where the bar and the program agreed with each
#                             other and were both wrong -- 39 of 54 live
#                             solves never produced a disagreement at all.
#                             Two models choosing test inputs share about 2%
#                             of them (calibration/two_bar_overlap.py), which
#                             is what kills agreement as a signal and is
#                             exactly what makes a union worth having: bar2's
#                             cases are almost all calls the first reader
#                             never probed. Costs one cases turn of tokens and
#                             no wall-clock -- it runs beside the program.
#                             Needs SOLVER_INDEPENDENT_BAR.
#   SOLVER_JUDGE=true         when the bar and the program disagree about one
#                             or two cases, ask a THIRD reader what those
#                             calls must return -- shown the statement and the
#                             calls, no program and no expected values. Of ten
#                             single-case disagreements in a live run, nine
#                             ended with the program's own author ruling its
#                             own case wrong and keeping its program. Asked
#                             the narrow question, two readings agree on 91 of
#                             97 expected values with the inputs held fixed
#                             (calibration/fixed_inputs.py); asked to choose
#                             inputs they agree on 5 of 233 -- so it is put
#                             the first question and never the second.
#   SOLVER_REPAIR_ROTATION=opus:low,fable:low,opus:low
#                             the SCHEDULE a correction round walks, one entry
#                             per round, cycling. Round N takes entry
#                             (N-1) mod len, so this reads straight off:
#                               1 opus  2 fable  3 opus  4 opus  5 fable  6 opus
#                             -- opus on two rounds in three. A repeated entry
#                             is how a ratio is stated; naming each model once
#                             is strict alternation; naming one is a repair
#                             that never moves. Two consecutive entries naming
#                             the same model keep the same conversation, so its
#                             context survives. There is no lap and nothing to
#                             be spent: a passing program or the deadline ends
#                             it. A repair that stays where the program was
#                             written asks a model to find a fault in its own
#                             reading, which is why round 2 is not opus.
#   SOLVER_VERIFY_EXECUTOR=docker    matches the validator: 256 MiB with swap
#                             off, one container, where an OOM fails the whole
#                             suite rather than the case that caused it. The
#                             subprocess backend gives 1 GiB, so an answer
#                             allocating 400 MB passed every local case and
#                             lost every hidden one. Falls back to subprocess
#                             for Python when no daemon answers, and says so.
#   SOLVER_SIZE_PROBE=true    time the finished program on one large valid
#                             input, at the statement's own limits, under the
#                             validator's five-second per-test clock. No
#                             oracle: "did it finish" needs no second opinion,
#                             and no case on the bar is ever that size --
#                             every `expected` is derived by hand.
#   SOLVER_SOLUTION_CACHE=1   keep answers that passed everything, keyed by
#                             the problem, and serve a repeat in about a
#                             second without opening a conversation. Kept only
#                             when the answer passed its own cases with
#                             nothing contested AND was timed at scale.
#                             SOLVER_SOLUTION_CACHE_DIR=solutions/cache
# SOLVER_MAX_ATTEMPTS=0
# SOLVER_SELF_TESTS=true
# SOLVER_SECOND_OPINION=true
# SOLVER_INDEPENDENT_BAR=true
# SOLVER_SECOND_BAR=true
# SOLVER_JUDGE=true
# SOLVER_REPAIR_ROTATION=opus:low,fable:low,opus:low
# SOLVER_VERIFY_EXECUTOR=docker
# SOLVER_SIZE_PROBE=true
# SOLVER_SOLUTION_CACHE=1

# Selector overrides, for the day a chat UI renames something. Run
# `python -m solvers.doctor claude --probe` first; it prints what to set.
# CLAUDE_COPY_NAME=copy
# CLAUDE_URL=https://claude.ai/new

# The miner binds on all interfaces and advertises its externally reachable
# address through Bittensor. Leave AXON_EXTERNAL_IP empty for auto-detection.
AXON_HOST=0.0.0.0
AXON_PORT=8091
AXON_EXTERNAL_IP=
# How far past the advertised deadline the solve may run. The validator does
# NOT stop at deadline_s: rlvr/neurons/decentralized.py bounds the whole
# exchange at deadline_s + 10 (_MINER_RESPONSE_GRACE_S), and the reference
# handler cancelled the solve at deadline_s flat, giving back seconds nobody
# was asking for. Not all ten -- that grace is also the response's window to
# cross the wire, and the validator's clock starts before the request arrives.
# 0 restores the reference behaviour exactly.
MINER_RESPONSE_GRACE_S=5
MINER_MAX_CONCURRENT_REQUESTS=4
MINER_MAX_REQUEST_BYTES=1000000
MINER_METAGRAPH_SYNC_S=300
MINER_MIN_STAKE=0
MINER_REQUIRE_VALIDATOR_PERMIT=true
